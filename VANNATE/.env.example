# Vannate runs without keys locally. Uncomment providers as you connect them.

# Local / hosted reasoning
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral
# MISTRAL_API_KEY=

# Database and auth
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=

# RAG vector database
# QDRANT_URL=
# QDRANT_API_KEY=

# Maps, routing, and geocoding
# OPENROUTESERVICE_API_KEY=
# GRAPHHOPPER_API_KEY=
# LOCATIONIQ_API_KEY=
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Evidence analysis
# OCR_PROVIDER=tesseract
# WHISPER_BASE_URL=
# VIDEO_ANALYSIS_BASE_URL=

# Notifications and communication
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# RESEND_API_KEY=

# Donation payments, test mode first
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
